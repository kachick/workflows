{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "json": {
    "trailingCommas": "never"
  },
  "yaml": {
    "quotes": "preferSingle",
    "trimTrailingWhitespaces": false
  },
  "toml": {
    "quoteStyle": "maintain"
  },
  "shuck": {
    "useTabs": true
  },
  "gofumpt": {
    "langVersion": "go1.27",
    "modulePath": "github.com/kachick/workflows"
  },
  "plugins": [
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.28.0",
    "npm:@dprint/toml@0.9.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/nix@0.1.2",
    "npm:@dprint/shuck@0.2.2",
    "npm:@jakebailey/dprint-plugin-gofumpt@0.0.20"
  ]
}
